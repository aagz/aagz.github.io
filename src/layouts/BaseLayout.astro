---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'aagz — заметки',
  description = 'Личный блог о технологиях, идеях и вещах, которые хочется запомнить.',
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav aria-label="Основная навигация">
        <a class="brand" href="/">aagz<span>.</span></a>
        <div class="nav-links">
          <a href="/">Все заметки</a>
          <a href="/rss.xml">RSS</a>
        </div>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <p>© {new Date().getFullYear()} aagz</p>
    </footer>
  </body>
</html>

<style is:global>
  :root { color: #202124; background: #fffdf9; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  * { box-sizing: border-box; }
  body { margin: 0; line-height: 1.65; }
  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .site-header, main, footer { width: min(100% - 2.5rem, 46rem); margin-inline: auto; }
  .site-header { padding: 2rem 0 3.5rem; }
  nav { display: flex; align-items: center; justify-content: space-between; font-size: .95rem; }
  .nav-links { display: flex; gap: 1rem; }
  .brand { font-size: 1.25rem; font-weight: 750; letter-spacing: -.06em; text-decoration: none; }
  .brand span { color: #e4572e; }
  main { min-height: calc(100vh - 11rem); }
  footer { padding: 4rem 0 2rem; color: #777; font-size: .85rem; }
  h1, h2, h3 { line-height: 1.18; letter-spacing: -.035em; }
  h1 { font-size: clamp(2.25rem, 7vw, 4.5rem); margin: 0; }
  h2 { margin-top: 2.5rem; }
  code { padding: .15em .35em; background: #f1eee8; border-radius: .25rem; font-size: .9em; }
  pre { overflow-x: auto; padding: 1rem 1.25rem; background: #292724; color: #f7f4ef; border-radius: .5rem; }
  pre code { padding: 0; background: transparent; }
</style>
